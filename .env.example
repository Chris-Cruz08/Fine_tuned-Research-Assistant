# Hugging Face Hub — needed for dataset download (public, no token required)
# and for pushing the fine-tuned model (token with write access required)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_HUB_MODEL_ID=your-username/qwen2.5-3b-ai-research-qa

# MLflow tracking (local file store by default; point to a remote server if you have one)
MLFLOW_TRACKING_URI=./mlflow/mlruns
MLFLOW_EXPERIMENT_NAME=ai-research-qa-finetune

# Base + fine-tuned model identifiers used across eval scripts
BASE_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
FINETUNED_MODEL_ID=your-username/qwen2.5-3b-ai-research-qa
